# ─────────────────────────────────────────────
# GeordieDaz — Local Environment Variables
# Copy to .env and fill in your real values
# ─────────────────────────────────────────────

# Your OpenAI API Key (covers voice, embeddings, memory extraction)
OPENAI_API_KEY=sk-...

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://geordiedaz:geordiedaz@localhost:5432/geordiedaz

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379/0

# CORS — add your local frontend URL
ALLOWED_ORIGINS=http://localhost:5173

# Memory tuning
MEMORY_IMPORTANCE_THRESHOLD=0.6
WORKING_MEMORY_SIZE=20
SESSION_TTL_HOURS=24

# Demo account credentials
DEMO_EMAIL=geordie@geordiedaz.com
DEMO_PASSWORD=GeordieDaz2026!
DEMO_USERNAME=geordie_demo

# Set to "development" for verbose SQL logs
ENVIRONMENT=development
LOG_LEVEL=INFO
